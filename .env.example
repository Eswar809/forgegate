# Slack Socket Mode — paste the two tokens from the ForgeGate app settings.
# Bot token: OAuth & Permissions -> Bot User OAuth Token (xoxb-...)
# App token: Basic Information -> App-Level Tokens (xapp-..., connections:write)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# OpenAI-compatible model endpoint (Meta Model API, vLLM, OpenAI, ...)
FORGEGATE_API_BASE=
FORGEGATE_API_KEY=
FORGEGATE_MODEL=

# Optional: force a transport for FORGEGATE_API_BASE ("openai" default, or "anthropic")
FORGEGATE_API_STYLE=

# Seconds to wait for one completion. Raise it for slow local proxies.
FORGEGATE_HTTP_TIMEOUT=

# Extra attempts after a 5xx/timeout (default 1).
FORGEGATE_HTTP_RETRIES=

# Anthropic-compatible endpoint (used only when FORGEGATE_API_BASE is empty).
# Works with the Claude API, any Anthropic-proxy, or a local gateway such as
# opencode-proxy at http://127.0.0.1:8084.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

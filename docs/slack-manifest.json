{
  "display_information": {
    "name": "ForgeGate",
    "description": "Verified self-extension for ops agents",
    "background_color": "#1f2937"
  },
  "features": {
    "bot_user": {
      "display_name": "ForgeGate",
      "always_online": true
    },
    "app_home": {
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "im:history",
        "im:read",
        "im:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.im"
      ]
    },
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
